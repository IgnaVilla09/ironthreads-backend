# ─── Server ────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database (PostgreSQL) ─────────────────────────
# For local: use your local postgres connection string
# For Render: set this in Render Dashboard > Environment
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# ─── CORS ──────────────────────────────────────────
# Comma-separated list of allowed origins
# For local dev: http://localhost:3000
# For production: https://tu-app.vercel.app
CORS_ORIGIN="http://localhost:3000"

# ─── Tienda Nube / Auth ─────────────────────────────
ABANDONED_API_URL="https://backend-ironapi.onrender.com"
APP_CREDENTIALS_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
SESSION_TTL_DAYS=3

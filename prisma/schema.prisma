datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  label    String
  products Product[]

  @@index([name])
  @@map("categories")
}

model Color {
  id       String           @id @default(uuid()) @db.Uuid
  name     String           @unique
  label    String
  hex      String?
  variants ProductVariant[]

  @@index([name])
  @@map("colors")
}

model Size {
  id       String           @id @default(uuid()) @db.Uuid
  name     String           @unique
  label    String
  variants ProductVariant[]

  @@index([name])
  @@map("sizes")
}

model PointOfSale {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  label     String
  depositos Deposito[]
  products  Product[]

  @@index([name])
  @@map("points_of_sale")
}

model Deposito {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  label          String
  pointOfSaleId  String      @db.Uuid
  pointOfSale    PointOfSale @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([name, pointOfSaleId])
  @@index([pointOfSaleId])
  @@index([name])
  @@map("depositos")
}

model Product {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  categoryId     String           @db.Uuid
  category       Category         @relation(fields: [categoryId], references: [id])
  pointOfSaleId  String           @db.Uuid
  pointOfSale    PointOfSale      @relation(fields: [pointOfSaleId], references: [id])
  depositoId     String?          @db.Uuid
  deposito       Deposito?        @relation(fields: [depositoId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  variants       ProductVariant[]

  @@index([name])
  @@index([categoryId])
  @@index([pointOfSaleId])
  @@index([depositoId])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  colorId   String   @db.Uuid
  sizeId    String   @db.Uuid
  sku       String   @unique
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     Color    @relation(fields: [colorId], references: [id])
  size      Size     @relation(fields: [sizeId], references: [id])
  saleItems SaleItem[]

  @@index([productId])
  @@index([colorId])
  @@index([sizeId])
  @@index([sku])
  @@index([stock])
  @@map("product_variants")
}

enum PaymentMethod {
  EFECTIVO
  MERCADO_PAGO
  OTRO

  @@map("payment_method")
}

model Sale {
  id            String        @id @default(uuid()) @db.Uuid
  paymentMethod PaymentMethod
  total         Int
  observaciones String?
  createdAt     DateTime      @default(now())
  items         SaleItem[]

  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id          String         @id @default(uuid()) @db.Uuid
  saleId      String         @db.Uuid
  variantId   String         @db.Uuid
  productName String
  colorName   String
  sizeName    String
  quantity    Int
  unitPrice   Int            @default(0)
  sale        Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([variantId])
  @@map("sale_items")
}

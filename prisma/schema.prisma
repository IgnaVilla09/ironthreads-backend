datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AppUser {
  id                   String       @id @default(uuid()) @db.Uuid
  firstName            String
  lastName             String
  username             String       @unique
  passwordHash         String       @map("password_hash")
  adminApiKeyEncrypted String       @map("admin_api_key_encrypted")
  isActive             Boolean      @default(true) @map("is_active")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  sessions             AppSession[]

  @@index([username])
  @@map("app_users")
}

model AppSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("app_sessions")
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  label    String
  products Product[]

  @@index([name])
  @@map("categories")
}

model Color {
  id       String           @id @default(uuid()) @db.Uuid
  name     String           @unique
  label    String
  hex      String?
  variants ProductVariant[]

  @@index([name])
  @@map("colors")
}

model Size {
  id       String           @id @default(uuid()) @db.Uuid
  name     String           @unique
  label    String
  variants ProductVariant[]

  @@index([name])
  @@map("sizes")
}

model PointOfSale {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String          @unique
  label               String
  depositos           Deposito[]
  inventory           InventoryItem[]
  sales               Sale[]
  catalogOrders       CatalogOrder[]
  transfersFrom       StockTransfer[] @relation("stockTransferFrom")
  transfersTo         StockTransfer[] @relation("stockTransferTo")

  @@index([name])
  @@map("points_of_sale")
}

model Deposito {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  label          String
  pointOfSaleId  String          @db.Uuid
  pointOfSale    PointOfSale     @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)
  inventory      InventoryItem[]
  sales          Sale[]
  transfersFrom  StockTransfer[] @relation("stockTransferFromDeposito")
  transfersTo    StockTransfer[] @relation("stockTransferToDeposito")

  @@unique([name, pointOfSaleId])
  @@index([pointOfSaleId])
  @@index([name])
  @@map("depositos")
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  description String?
  categoryId  String           @db.Uuid
  imageUrl    String?          @map("image_url")
  price       Int?
  category    Category         @relation(fields: [categoryId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
  catalogOrderItems CatalogOrderItem[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id        String           @id @default(uuid()) @db.Uuid
  productId String           @db.Uuid
  colorId   String           @db.Uuid
  sizeId    String           @db.Uuid
  sku       String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     Color            @relation(fields: [colorId], references: [id])
  size      Size             @relation(fields: [sizeId], references: [id])
  inventory InventoryItem[]
  saleItems SaleItem[]
  transfers StockTransfer[]
  catalogOrderItems CatalogOrderItem[]

  @@index([productId])
  @@index([colorId])
  @@index([sizeId])
  @@index([sku])
  @@map("product_variants")
}

model InventoryItem {
  id            String           @id @default(uuid()) @db.Uuid
  variantId     String           @db.Uuid
  pointOfSaleId String           @db.Uuid
  depositoId    String?          @db.Uuid
  stock         Int              @default(0)
  variant       ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  pointOfSale   PointOfSale      @relation(fields: [pointOfSaleId], references: [id])
  deposito      Deposito?        @relation(fields: [depositoId], references: [id])
  saleItems     SaleItem[]

  @@index([variantId, pointOfSaleId, depositoId])
  @@index([variantId])
  @@index([pointOfSaleId])
  @@index([depositoId])
  @@index([stock])
  @@map("inventory_items")
}

model StockTransfer {
  id                String          @id @default(uuid()) @db.Uuid
  variantId         String          @db.Uuid
  fromPointOfSaleId String          @db.Uuid
  fromDepositoId    String?         @db.Uuid
  toPointOfSaleId   String          @db.Uuid
  toDepositoId      String?         @db.Uuid
  quantity          Int
  createdAt         DateTime        @default(now())
  variant           ProductVariant  @relation(fields: [variantId], references: [id])
  fromPointOfSale   PointOfSale     @relation("stockTransferFrom", fields: [fromPointOfSaleId], references: [id])
  toPointOfSale     PointOfSale     @relation("stockTransferTo", fields: [toPointOfSaleId], references: [id])
  fromDeposito      Deposito?       @relation("stockTransferFromDeposito", fields: [fromDepositoId], references: [id])
  toDeposito        Deposito?       @relation("stockTransferToDeposito", fields: [toDepositoId], references: [id])

  @@index([createdAt])
  @@index([variantId])
  @@map("stock_transfers")
}

enum PaymentMethod {
  EFECTIVO
  MERCADO_PAGO
  OTRO

  @@map("payment_method")
}

enum CatalogOrderStatus {
  PENDING_PAYMENT
  PAYMENT_REPORTED
  CONFIRMED
  CANCELLED
  REJECTED
  OUT_OF_STOCK

  @@map("catalog_order_status")
}

model Sale {
  id            String        @id @default(uuid()) @db.Uuid
  pointOfSaleId String?       @db.Uuid
  depositoId    String?       @db.Uuid
  pointOfSale   PointOfSale?  @relation(fields: [pointOfSaleId], references: [id])
  deposito      Deposito?     @relation(fields: [depositoId], references: [id])
  paymentMethod PaymentMethod
  total         Int
  observaciones String?
  createdAt     DateTime      @default(now())
  items         SaleItem[]
  catalogOrder  CatalogOrder?

  @@index([createdAt])
  @@index([pointOfSaleId])
  @@index([depositoId])
  @@map("sales")
}

model SaleItem {
  id              String         @id @default(uuid()) @db.Uuid
  saleId          String         @db.Uuid
  variantId       String?        @db.Uuid
  inventoryItemId String?        @db.Uuid
  productName     String
  colorName       String
  sizeName        String
  quantity        Int
  unitPrice       Int            @default(0)
  sale            Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([saleId])
  @@index([variantId])
  @@index([inventoryItemId])
  @@map("sale_items")
}

model CatalogOrder {
  id                String             @id @default(uuid()) @db.Uuid
  pointOfSaleId     String             @db.Uuid @map("point_of_sale_id")
  saleId            String?            @unique @db.Uuid @map("sale_id")
  status            CatalogOrderStatus @default(PENDING_PAYMENT)
  customerFirstName String             @map("customer_first_name")
  customerLastName  String             @map("customer_last_name")
  customerPhone     String             @map("customer_phone")
  paymentMethod     PaymentMethod      @map("payment_method")
  total             Int
  notes             String?
  whatsAppProofSent Boolean            @default(false) @map("whatsapp_proof_sent")
  confirmedAt       DateTime?          @map("confirmed_at")
  cancelledAt       DateTime?          @map("cancelled_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  pointOfSale PointOfSale       @relation(fields: [pointOfSaleId], references: [id])
  sale        Sale?             @relation(fields: [saleId], references: [id])
  items       CatalogOrderItem[]

  @@index([status])
  @@index([pointOfSaleId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("catalog_orders")
}

model CatalogOrderItem {
  id                  String         @id @default(uuid()) @db.Uuid
  orderId             String         @db.Uuid @map("order_id")
  productId           String         @db.Uuid @map("product_id")
  variantId           String         @db.Uuid @map("variant_id")
  productNameSnapshot String         @map("product_name_snapshot")
  colorNameSnapshot   String         @map("color_name_snapshot")
  sizeNameSnapshot    String         @map("size_name_snapshot")
  unitPriceSnapshot   Int            @map("unit_price_snapshot")
  quantity            Int
  createdAt           DateTime       @default(now()) @map("created_at")

  order   CatalogOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("catalog_order_items")
}

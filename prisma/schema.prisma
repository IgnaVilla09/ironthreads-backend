datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  label    String
  products Product[]

  @@index([name])
  @@map("categories")
}

model Color {
  id       String           @id @default(uuid()) @db.Uuid
  name     String           @unique
  label    String
  hex      String?
  variants ProductVariant[]

  @@index([name])
  @@map("colors")
}

model Size {
  id       String           @id @default(uuid()) @db.Uuid
  name     String           @unique
  label    String
  variants ProductVariant[]

  @@index([name])
  @@map("sizes")
}

model PointOfSale {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String          @unique
  label               String
  depositos           Deposito[]
  inventory           InventoryItem[]
  sales               Sale[]
  transfersFrom       StockTransfer[] @relation("stockTransferFrom")
  transfersTo         StockTransfer[] @relation("stockTransferTo")

  @@index([name])
  @@map("points_of_sale")
}

model Deposito {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  label          String
  pointOfSaleId  String          @db.Uuid
  pointOfSale    PointOfSale     @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)
  inventory      InventoryItem[]
  sales          Sale[]
  transfersFrom  StockTransfer[] @relation("stockTransferFromDeposito")
  transfersTo    StockTransfer[] @relation("stockTransferToDeposito")

  @@unique([name, pointOfSaleId])
  @@index([pointOfSaleId])
  @@index([name])
  @@map("depositos")
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  description String?
  categoryId  String           @db.Uuid
  category    Category         @relation(fields: [categoryId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id        String           @id @default(uuid()) @db.Uuid
  productId String           @db.Uuid
  colorId   String           @db.Uuid
  sizeId    String           @db.Uuid
  sku       String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     Color            @relation(fields: [colorId], references: [id])
  size      Size             @relation(fields: [sizeId], references: [id])
  inventory InventoryItem[]
  saleItems SaleItem[]
  transfers StockTransfer[]

  @@index([productId])
  @@index([colorId])
  @@index([sizeId])
  @@index([sku])
  @@map("product_variants")
}

model InventoryItem {
  id            String           @id @default(uuid()) @db.Uuid
  variantId     String           @db.Uuid
  pointOfSaleId String           @db.Uuid
  depositoId    String?          @db.Uuid
  stock         Int              @default(0)
  variant       ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  pointOfSale   PointOfSale      @relation(fields: [pointOfSaleId], references: [id])
  deposito      Deposito?        @relation(fields: [depositoId], references: [id])
  saleItems     SaleItem[]

  @@index([variantId, pointOfSaleId, depositoId])
  @@index([variantId])
  @@index([pointOfSaleId])
  @@index([depositoId])
  @@index([stock])
  @@map("inventory_items")
}

model StockTransfer {
  id                String          @id @default(uuid()) @db.Uuid
  variantId         String          @db.Uuid
  fromPointOfSaleId String          @db.Uuid
  fromDepositoId    String?         @db.Uuid
  toPointOfSaleId   String          @db.Uuid
  toDepositoId      String?         @db.Uuid
  quantity          Int
  createdAt         DateTime        @default(now())
  variant           ProductVariant  @relation(fields: [variantId], references: [id])
  fromPointOfSale   PointOfSale     @relation("stockTransferFrom", fields: [fromPointOfSaleId], references: [id])
  toPointOfSale     PointOfSale     @relation("stockTransferTo", fields: [toPointOfSaleId], references: [id])
  fromDeposito      Deposito?       @relation("stockTransferFromDeposito", fields: [fromDepositoId], references: [id])
  toDeposito        Deposito?       @relation("stockTransferToDeposito", fields: [toDepositoId], references: [id])

  @@index([createdAt])
  @@index([variantId])
  @@map("stock_transfers")
}

enum PaymentMethod {
  EFECTIVO
  MERCADO_PAGO
  OTRO

  @@map("payment_method")
}

model Sale {
  id            String        @id @default(uuid()) @db.Uuid
  pointOfSaleId String?       @db.Uuid
  depositoId    String?       @db.Uuid
  pointOfSale   PointOfSale?  @relation(fields: [pointOfSaleId], references: [id])
  deposito      Deposito?     @relation(fields: [depositoId], references: [id])
  paymentMethod PaymentMethod
  total         Int
  observaciones String?
  createdAt     DateTime      @default(now())
  items         SaleItem[]

  @@index([createdAt])
  @@index([pointOfSaleId])
  @@index([depositoId])
  @@map("sales")
}

model SaleItem {
  id              String         @id @default(uuid()) @db.Uuid
  saleId          String         @db.Uuid
  variantId       String?        @db.Uuid
  inventoryItemId String?        @db.Uuid
  productName     String
  colorName       String
  sizeName        String
  quantity        Int
  unitPrice       Int            @default(0)
  sale            Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([saleId])
  @@index([variantId])
  @@index([inventoryItemId])
  @@map("sale_items")
}
